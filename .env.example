# Copy to .env.local. Never commit real credentials.
# Demo mode validates requests without contacting Klaviyo.
# Public newsletter signup is independently enabled below.
SIDEQUEST_MODE=demo

# invited (default) or public. Public requires Vercel BotID and a double-opt-in list.
# Public signup never overwrites profile preferences; profile/events keep their allowlist.
KLAVIYO_SUBSCRIPTION_ACCESS=invited

# Independent Oracle profile save; does not change the other integration modes.
ORACLE_PROFILE_MODE=demo
# Invited test addresses only until authenticated account sessions are added.
ORACLE_PROFILE_ALLOWED_EMAILS=

# Server-only. Required for live Klaviyo adapters.
# Public newsletter needs lists:read, lists:write, profiles:write, subscriptions:write.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
KLAVIYO_API_REVISION=2026-10-15

# Optional public identifier for a future supported onsite/chat loader.
# A Site ID is not a private API key. The scaffold does not load the widget.
NEXT_PUBLIC_KLAVIYO_SITE_ID=

# Development gate for identify/events and invited subscriptions. Empty blocks those requests.
KLAVIYO_LIVE_ALLOWED_EMAILS=
